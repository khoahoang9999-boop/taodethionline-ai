{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "User accounts and device activations for exam generation software",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "createdDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "maxDevices": { "type": "number" },
        "devices": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "apiKeys": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["customerName", "phone", "status"]
    },
    "CustomPpct": {
      "title": "CustomPpct",
      "description": "Saved customized teaching curriculum plans",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "period": { "type": "string" },
        "schoolYear": { "type": "string" },
        "userCode": { "type": "string" },
        "isPermanent": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "scopeConfig": { "type": "object" }
      },
      "required": ["name", "subject", "grade", "period"]
    },
    "DeletedAccount": {
      "title": "DeletedAccount",
      "description": "Permanent tombstone record for deleted user accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rawId": { "type": "string" },
        "deletedAt": { "type": "string" }
      },
      "required": ["id", "deletedAt"]
    },
    "SavedExam": {
      "title": "SavedExam",
      "description": "Saved exam variants, matrix, and specification records",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "period": { "type": "string" },
        "schoolName": { "type": "string" },
        "examFormat": { "type": "string" },
        "schoolYear": { "type": "string" },
        "time": { "type": "string" },
        "userCode": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "matrix": { "type": "array" },
        "specification": { "type": "array" },
        "examVariants": { "type": "array" },
        "code": { "type": "string" }
      },
      "required": ["title", "subject", "grade", "period"]
    },
    "SavedStudyGuide": {
      "title": "SavedStudyGuide",
      "description": "Saved student study guides and revision outlines",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "period": { "type": "string" },
        "schoolName": { "type": "string" },
        "departmentName": { "type": "string" },
        "schoolYear": { "type": "string" },
        "userCode": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "topics": { "type": "array" },
        "mcq": { "type": "array" },
        "tf": { "type": "array" },
        "shortAnswer": { "type": "array" },
        "applied": { "type": "array" }
      },
      "required": ["title", "subject", "grade", "period"]
    }
  },
  "firestore": {
    "/accounts/{id}": {
      "schema": "Account",
      "description": "Account list by user code ID"
    },
    "/custom_ppct/{id}": {
      "schema": "CustomPpct",
      "description": "Curriculum planning records"
    },
    "/deleted_accounts/{id}": {
      "schema": "DeletedAccount",
      "description": "Permanent tombstones for deleted accounts"
    },
    "/saved_exams/{id}": {
      "schema": "SavedExam",
      "description": "Saved exam records with matrix and spec"
    },
    "/saved_study_guides/{id}": {
      "schema": "SavedStudyGuide",
      "description": "Saved study guide records"
    }
  }
}
