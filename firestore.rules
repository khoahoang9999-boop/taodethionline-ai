rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /accounts/{id} {
      allow read, write: if true;
    }
    match /custom_ppct/{id} {
      allow read, write: if true;
    }
    match /deleted_accounts/{id} {
      allow read, write: if true;
    }
    match /saved_exams/{id} {
      allow read, write: if true;
    }
    match /saved_study_guides/{id} {
      allow read, write: if true;
    }
  }
}
